---
import '../styles/global.css';
import '../styles/sponsors.css';
import { ArrowUpRight, LockKeyhole, Minus, Plus } from '@lucide/astro';
import { env } from 'cloudflare:workers';
import SiteLayout from '../components/SiteLayout.astro';
import { sponsorRules } from '../data/sponsors';
import { defaultLocale, getLocale, localeConfig, locales, type Locale } from '../i18n';
import { getLocalePath } from '../i18n/config';
import { getDefaultSponsorAmount, getProjectedSponsorRank } from '../lib/sponsor-ranking';
import { getRankedSponsors } from '../lib/sponsors';

export const prerender = false;

const base = import.meta.env.BASE_URL;
const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const workerEnv = env as unknown as { SPONSORS_DB?: D1Database };
const rankedSponsors = await getRankedSponsors(workerEnv.SPONSORS_DB);
const minimumAmountUsd = sponsorRules.minimumIncrementUsd;
const defaultAmountUsd = getDefaultSponsorAmount(rankedSponsors, sponsorRules.minimumIncrementUsd);
const initialRank = getProjectedSponsorRank(rankedSponsors, defaultAmountUsd);
const siteUrl = 'https://jevbest.com/';
const pagePath = `${getLocalePath(locale)}sponsors/`;
const pageUrl = `${siteUrl}${pagePath}`;
const returnPath = `/${pagePath}`;
const sponsorEndpoint = `${base}api/sponsors/`;
const checkoutAction = `${base}api/sponsors/checkout/`;

