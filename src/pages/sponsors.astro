const copyByLocale: Record<Locale, typeof en> = { en, zh, ja, ko, es, 'pt-br': ptBr };
const copy = copyByLocale[locale] ?? en;
const faviconUrl = (name: string, url: string) => name === 'blink.review'
  ? `https://www.google.com/s2/favicons?domain_url=${encodeURIComponent(url)}&sz=128`
  : `${new URL(url).origin}/favicon.ico`;
const domain = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<!doctype html>
<html lang={localeConfig[locale].languageTag} data-language={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={copy.description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    {locales.map((candidate) => <link rel="alternate" hreflang={localeConfig[candidate].languageTag} href={`${siteUrl}${getLocalePath(candidate)}sponsors/`} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${getLocalePath(defaultLocale)}sponsors/`} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <title>{copy.pageTitle}</title>
  </head>
  <body>
    <div class="app-shell">
      <SiteLayout locale={locale} activeSection="sponsors" mainClass="sponsors-main" sponsors={rankedSponsors.slice(0, sponsorRules.sidebarSlots)}>
        <div class="sponsors-page">
          <nav class="sponsors-breadcrumbs" aria-label="Breadcrumb">
            <a href={`${base}${getLocalePath(locale)}`}>{copy.breadcrumbHome}</a><span aria-hidden="true">/</span><span>{copy.breadcrumbCurrent}</span>
          </nav>

          <div class="sponsor-status" data-payment-status="success" hidden>{copy.success}</div>
          <div class="sponsor-status" data-payment-status="cancelled" hidden>{copy.cancelled}</div>

          <section class="sponsors-hero">
            <div class="sponsors-intro">
              <h1>{copy.title}</h1>
              <p>{copy.intro}</p>
            </div>

            <div class="claim-card">
              <h2 data-claim-heading>{copy.claim(initialRank, defaultAmountUsd)}</h2>
              <p>{copy.claimBody}</p>
              <form class="sponsor-form" id="sponsor-form" action={checkoutAction} method="post">
                <input type="hidden" name="returnPath" value={returnPath} />
                <div class="sponsor-field sponsor-amount-field">
                  <div class="sponsor-field-heading">
                    <small data-amount-hint>{copy.amountHint(minimumAmountUsd)}</small>
                  </div>
                  <div class="amount-stepper">
                    <button type="button" data-amount-decrease aria-label={copy.decreaseAmount} title={copy.decreaseAmount}><Minus size={18} stroke-width={2} aria-hidden="true" /></button>
                    <div class="amount-input"><span aria-hidden="true">$</span><input id="sponsor-amount" name="amount" type="number" min={minimumAmountUsd} step={sponsorRules.minimumIncrementUsd} value={defaultAmountUsd} aria-label={copy.amount} required inputmode="numeric" /></div>
                    <button type="button" data-amount-increase aria-label={copy.increaseAmount} title={copy.increaseAmount}><Plus size={18} stroke-width={2} aria-hidden="true" /></button>
                  </div>
                </div>
                <div class="sponsor-details">
                  <div class="sponsor-field">
                    <input id="sponsor-name" name="sponsorName" type="text" minlength="2" maxlength="80" placeholder={copy.namePlaceholder} aria-label={copy.name} autocomplete="organization" required />
                  </div>
                  <div class="sponsor-field">
                    <input id="sponsor-url" name="productUrl" type="url" maxlength="500" pattern="https://.*" placeholder={copy.urlPlaceholder} aria-label={copy.url} autocomplete="url" required />
                  </div>
                </div>
                <div class="sr-only" aria-hidden="true"><label for="company">Company</label><input id="company" name="company" type="text" tabindex="-1" autocomplete="off" /></div>
                <button class="claim-button" type="submit"><span>{copy.submit}</span><span><LockKeyhole size={13} stroke-width={1.8} aria-hidden="true" /> {copy.stripe}</span></button>
                <div class="sponsor-status" data-payment-status="error" data-tone="error" role="alert" hidden>{copy.error}</div>
              </form>
            </div>
          </section>

          <section class="sponsor-board" aria-labelledby="sponsor-board-title">
            <div class="board-heading">
              <h2 id="sponsor-board-title">{copy.boardTitle}</h2>
              <p>{copy.boardIntro}</p>
            </div>
            <ol class="sponsor-board-list" data-sponsor-board hidden={rankedSponsors.length === 0}>
              {rankedSponsors.map((sponsor, index) => (
                <li class="sponsor-board-row">
                  <span class="board-rank">#{index + 1}</span>
                  <span class:list={['board-logo', `sponsor-logo-${sponsor.logoTone}`]}><span aria-hidden="true">{sponsor.name.slice(0, 1).toUpperCase()}</span><img src={sponsor.logoUrl ?? faviconUrl(sponsor.name, sponsor.url)} alt="" width="52" height="52" loading="lazy" /></span>
                  <div class="board-product"><h3><a href={sponsor.url} target="_blank" rel="sponsored noreferrer" data-sponsor-click-url={sponsor.url}>{sponsor.name} <ArrowUpRight size={14} stroke-width={1.8} aria-hidden="true" /></a></h3><strong>${sponsor.amountUsd}</strong></div>
                  <div class="board-detail"><p>{sponsor.description}</p><div class="board-meta"><span>{domain(sponsor.url)}</span><span>·</span><span>{sponsor.clicks} {copy.clicks}</span></div></div>
                </li>
              ))}
            </ol>
            <div class="sponsor-board-empty" data-sponsor-board-empty hidden={rankedSponsors.length > 0}>
              <strong>{copy.emptyTitle}</strong>
              <p>{copy.emptyBody}</p>
            </div>
          </section>

          <section class="sponsor-rules" id="rules">
            <h2>{copy.rulesTitle}</h2>
            <ul>{copy.rules.map((rule) => <li>{rule}</li>)}</ul>
          </section>

        </div>
      </SiteLayout>
    </div>

    <script define:vars={{ endpoint: sponsorEndpoint, claimTemplate: copy.claim('__RANK__' as unknown as number, '__AMOUNT__' as unknown as number), clicksLabel: copy.clicks, minimumIncrementUsd: sponsorRules.minimumIncrementUsd, initialSponsors: rankedSponsors }}>
      const params = new URLSearchParams(window.location.search);
      const state = params.has('error') ? 'error' : params.get('payment');
      if (state) document.querySelector(`[data-payment-status="${state}"]`)?.removeAttribute('hidden');

      const menuButton = document.querySelector('.menu-button');
      const sidebarClose = document.querySelector('.sidebar-close');
      const navScrim = document.querySelector('.nav-scrim');
      const sidebar = document.querySelector('#sidebar');
      const compactLayout = window.matchMedia('(max-width: 1080px)');
      const setMenuOpen = (open) => {
        document.body.classList.toggle('menu-open', open);
        menuButton?.setAttribute('aria-expanded', String(open));
        if (sidebar instanceof HTMLElement && compactLayout.matches) {
          sidebar.toggleAttribute('inert', !open);
          sidebar.toggleAttribute('aria-hidden', !open);
        }
      };
      menuButton?.addEventListener('click', () => setMenuOpen(true));
      sidebarClose?.addEventListener('click', () => setMenuOpen(false));
      navScrim?.addEventListener('click', () => setMenuOpen(false));

      const localePicker = document.querySelector('[data-locale-picker]');
      const localeTrigger = localePicker?.querySelector('.locale-trigger');
      const localeMenu = localePicker?.querySelector('.locale-menu');
      localeTrigger?.addEventListener('click', () => {
        const open = localeTrigger.getAttribute('aria-expanded') !== 'true';
        localeTrigger.setAttribute('aria-expanded', String(open));
        localeMenu?.toggleAttribute('hidden', !open);
      });

      const faviconFor = (sponsor) => sponsor.logoUrl
        ?? (sponsor.name === 'blink.review'
          ? `https://www.google.com/s2/favicons?domain_url=${encodeURIComponent(sponsor.url)}&sz=128`
          : `${new URL(sponsor.url).origin}/favicon.ico`);
      const domainFor = (url) => new URL(url).hostname.replace(/^www\./, '');
      const replaceClaim = (template, rank, amount) => template
        .replace('__RANK__', String(rank))
        .replace('__AMOUNT__', String(amount));
      let sponsors = initialSponsors;
      const amountInput = document.querySelector('#sponsor-amount');
      const productUrlInput = document.querySelector('#sponsor-url');
      const amountDecrease = document.querySelector('[data-amount-decrease]');
      const amountIncrease = document.querySelector('[data-amount-increase]');
      const claimHeading = document.querySelector('[data-claim-heading]');
      let amountWasChanged = false;
      const projectedRank = (amount, productUrl = '') => {
        let canonicalUrl;
        try {
          canonicalUrl = productUrl ? new URL(productUrl).toString() : undefined;
        } catch {
          canonicalUrl = undefined;
        }
        const currentSponsor = canonicalUrl
          ? sponsors.find((sponsor) => sponsor.url === canonicalUrl)
          : undefined;
        const projectedTotal = amount + (currentSponsor?.amountUsd ?? 0);
        return 1 + sponsors.filter((sponsor) =>
          sponsor.url !== currentSponsor?.url && sponsor.amountUsd >= projectedTotal
        ).length;
      };
      const syncAmountControl = (normalize = false) => {
        if (!(amountInput instanceof HTMLInputElement)) return;
        const minimum = Number(amountInput.min) || minimumIncrementUsd;
        const parsed = Number(amountInput.value);
        if (normalize || !Number.isFinite(parsed) || parsed < minimum) {
          const stepped = Number.isFinite(parsed)
            ? Math.round(parsed / minimumIncrementUsd) * minimumIncrementUsd
            : minimum;
          amountInput.value = String(Math.max(minimum, stepped));
        }
        const amount = Number(amountInput.value);
        if (amountDecrease instanceof HTMLButtonElement) amountDecrease.disabled = amount <= minimum;
        if (claimHeading && Number.isFinite(amount)) {
          const productUrl = productUrlInput instanceof HTMLInputElement ? productUrlInput.value : '';
          claimHeading.textContent = replaceClaim(claimTemplate, projectedRank(amount, productUrl), amount);
        }
      };
      amountDecrease?.addEventListener('click', () => {
        if (!(amountInput instanceof HTMLInputElement)) return;
        amountWasChanged = true;
        amountInput.stepDown();
        syncAmountControl(true);
      });
      amountIncrease?.addEventListener('click', () => {
        if (!(amountInput instanceof HTMLInputElement)) return;
        amountWasChanged = true;
        amountInput.stepUp();
        syncAmountControl(true);
      });
      amountInput?.addEventListener('input', () => {
        amountWasChanged = true;
        syncAmountControl();
      });
      amountInput?.addEventListener('change', () => syncAmountControl(true));
      productUrlInput?.addEventListener('input', () => syncAmountControl());
      productUrlInput?.addEventListener('change', () => syncAmountControl());
      syncAmountControl(true);

      fetch(endpoint, {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      }).then(async (response) => {
        if (!response.ok) return;
        const payload = await response.json();
        sponsors = payload.sponsors;
        if (amountInput instanceof HTMLInputElement) {
          amountInput.min = String(payload.minimumAmountUsd ?? minimumIncrementUsd);
          if (!amountWasChanged && Number.isSafeInteger(payload.defaultSponsorAmountUsd)) {
            amountInput.value = String(payload.defaultSponsorAmountUsd);
          }
        }
        syncAmountControl(true);

        const board = document.querySelector('[data-sponsor-board]');
        const boardEmpty = document.querySelector('[data-sponsor-board-empty]');
        if (!board || !boardEmpty) return;
        board.toggleAttribute('hidden', payload.sponsors.length === 0);
        boardEmpty.toggleAttribute('hidden', payload.sponsors.length > 0);
        board.replaceChildren(...payload.sponsors.map((sponsor, index) => {
          const row = document.createElement('li');
          row.className = 'sponsor-board-row';
          const logo = document.createElement('span');
          logo.className = `board-logo sponsor-logo-${sponsor.logoTone}`;
          const fallback = document.createElement('span');
          fallback.textContent = sponsor.name.slice(0, 1).toUpperCase();
          const image = document.createElement('img');
          image.src = faviconFor(sponsor);
          image.alt = '';
          image.width = 52;
          image.height = 52;
          image.loading = 'lazy';
          image.addEventListener('error', () => image.remove(), { once: true });
          logo.appendChild(fallback);
          logo.appendChild(image);
          const rank = document.createElement('span');
          rank.className = 'board-rank';
          rank.textContent = `#${index + 1}`;
          const product = document.createElement('div');
          product.className = 'board-product';
          const title = document.createElement('h3');
          const link = document.createElement('a');
          link.href = sponsor.url;
          link.target = '_blank';
          link.rel = 'sponsored noreferrer';
          link.dataset.sponsorClickUrl = sponsor.url;
          link.textContent = sponsor.name;
          title.appendChild(link);
          const amount = document.createElement('strong');
          amount.textContent = `$${sponsor.amountUsd}`;
          product.appendChild(title);
          product.appendChild(amount);
          const detail = document.createElement('div');
          detail.className = 'board-detail';
          const description = document.createElement('p');
          description.textContent = sponsor.description;
          const meta = document.createElement('div');
          meta.className = 'board-meta';
          const domain = document.createElement('span');
          domain.textContent = domainFor(sponsor.url);
          const separatorOne = document.createElement('span');
          separatorOne.textContent = '·';
          const clicks = document.createElement('span');
          clicks.textContent = `${sponsor.clicks} ${clicksLabel}`;
          meta.appendChild(domain);
          meta.appendChild(separatorOne);
          meta.appendChild(clicks);
          detail.appendChild(description);
          detail.appendChild(meta);
          row.appendChild(rank);
          row.appendChild(logo);
          row.appendChild(product);
          row.appendChild(detail);
          return row;
        }));
      }).catch(() => {});
    </script>
  </body>
</html>
