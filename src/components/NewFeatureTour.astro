---
import type { Locale } from '../i18n';
import {
  ArrowRight,
  Check,
  Megaphone,
  X,
} from '@lucide/astro';

interface Props {
  locale: Locale;
}

type TourCopy = {
  eyebrow: string;
  next: string;
  done: string;
  skip: string;
  skipVideo: string;
  skipAndDone: string;
  step: (current: number, total: number) => string;
  videoLabel: (title: string) => string;
  steps: [
    { title: string; description: string },
  ];
};

const { locale } = Astro.props;
const copyByLocale: Record<Locale, TourCopy> = {
  en: {
    eyebrow: 'New on bestjev', next: 'Next', done: 'Finish', skip: 'Skip tour', skipVideo: 'Skip video', skipAndDone: 'Skip & finish',
    step: (current, total) => `Step ${current} of ${total}`,
    videoLabel: (title) => `Guide video: ${title}`,
    steps: [
      { title: 'Promote your product', description: 'Place your product in the project catalog, GitHub README, and site sidebar through the new sponsorship board.' },
    ],
  },
  zh: {
    eyebrow: 'bestjev 新功能', next: '下一步', done: '完成', skip: '跳过引导', skipVideo: '跳过视频', skipAndDone: '跳过并完成',
    step: (current, total) => `第 ${current} 步，共 ${total} 步`,
    videoLabel: (title) => `引导视频：${title}`,
    steps: [
      { title: '推广你的产品', description: '通过新的赞助榜，让你的产品出现在项目目录、GitHub README 和全站侧边栏。' },
    ],
  },
  ja: {
    eyebrow: 'bestjev の新機能', next: '次へ', done: '完了', skip: 'ツアーをスキップ', skipVideo: '動画をスキップ', skipAndDone: 'スキップして完了',
    step: (current, total) => `${total}ステップ中${current}`, videoLabel: (title) => `ガイド動画：${title}`,
    steps: [
      { title: 'プロダクトを宣伝', description: '新しいスポンサー枠で、プロジェクト一覧、GitHub README、サイトのサイドバーにプロダクトを掲載できます。' },
    ],
  },
  ko: {
    eyebrow: 'bestjev 새 기능', next: '다음', done: '완료', skip: '안내 건너뛰기', skipVideo: '영상 건너뛰기', skipAndDone: '건너뛰고 완료',
    step: (current, total) => `${total}단계 중 ${current}단계`, videoLabel: (title) => `안내 영상: ${title}`,
    steps: [
      { title: '제품 홍보하기', description: '새 스폰서 보드를 통해 프로젝트 목록, GitHub README와 사이트 사이드바에 제품을 소개하세요.' },
    ],
  },
  es: {
    eyebrow: 'Novedades de bestjev', next: 'Siguiente', done: 'Finalizar', skip: 'Omitir guía', skipVideo: 'Omitir vídeo', skipAndDone: 'Omitir y finalizar',
    step: (current, total) => `Paso ${current} de ${total}`, videoLabel: (title) => `Vídeo guía: ${title}`,
    steps: [
      { title: 'Promociona tu producto', description: 'Muestra tu producto en el catálogo, el README de GitHub y la barra lateral mediante el nuevo panel de patrocinio.' },
    ],
  },
  'pt-br': {
    eyebrow: 'Novidades no bestjev', next: 'Próximo', done: 'Concluir', skip: 'Pular guia', skipVideo: 'Pular vídeo', skipAndDone: 'Pular e concluir',
    step: (current, total) => `Etapa ${current} de ${total}`, videoLabel: (title) => `Vídeo-guia: ${title}`,
    steps: [
      { title: 'Promova seu produto', description: 'Exiba seu produto no catálogo, no no README do GitHub e na barra lateral por meio do novo painel de patrocínio.' },
    ],
  },
};

const copy = copyByLocale[locale];
const steps = [
  {
    ...copy.steps[0],
    videoUrl: 'https://media.jevbest.com/onboarding/sponsor-demo.mp4',
    posterUrl: 'https://media.jevbest.com/onboarding/sponsor-demo-cover.jpg',
    Icon: Megaphone,
  },
] as const;
---

<dialog
  class="feature-tour"
  data-feature-tour
  data-tour-version="2026-09-onboarding-demo-v2"
  aria-labelledby="feature-tour-title-0"
  aria-describedby="feature-tour-description-0"
>
  <div class="feature-tour-shell">
    <header class="feature-tour-header">
      <div>
        <span>{copy.eyebrow}</span>
        <strong data-tour-counter aria-live="polite">{copy.step(1, steps.length)}</strong>
      </div>
      <button class="feature-tour-skip" type="button" data-tour-skip aria-label={copy.skip} title={copy.skip}>
        <X size={18} stroke-width={1.9} aria-hidden="true" />
      </button>
    </header>

    <div class="feature-tour-stage">
      {steps.map((step, index) => (
        <section class="feature-tour-step" data-tour-step={index} data-counter-label={copy.step(index + 1, steps.length)} hidden={index !== 0} aria-hidden={index !== 0 ? 'true' : 'false'}>
          <div class="feature-tour-media">
            <video
              controls
              muted
              playsinline
              preload="metadata"
              poster={step.posterUrl}
              aria-label={copy.videoLabel(step.title)}
            >
              <source src={step.videoUrl} type="video/mp4" />
            </video>
            <span class="feature-tour-video-label"><step.Icon size={15} stroke-width={1.8} aria-hidden="true" /> {copy.videoLabel(step.title)}</span>
          </div>

          <div class="feature-tour-copy">
            <span class="feature-tour-number" aria-hidden="true">0{index + 1}</span>
            <h2 id={`feature-tour-title-${index}`} tabindex="-1">{step.title}</h2>
            <p id={`feature-tour-description-${index}`}>{step.description}</p>
          </div>
        </section>
      ))}
    </div>

    <footer class="feature-tour-footer">
      <div class="feature-tour-progress" aria-hidden="true">
        {steps.map((_, index) => (
          <span data-tour-dot={index} aria-current={index === 0 ? 'step' : undefined}></span>
        ))}
      </div>
      <div class="feature-tour-controls">
        <button
          class="feature-tour-next"
          type="button"
          data-tour-next
          data-next-label={copy.next}
          data-done-label={copy.done}
          data-skip-video-label={copy.skipVideo}
          data-skip-done-label={copy.skipAndDone}
        >
          <span>{copy.next}</span><ArrowRight class="tour-next-icon" size={16} stroke-width={1.8} aria-hidden="true" /><Check class="tour-done-icon" size={16} stroke-width={2} aria-hidden="true" />
        </button>
      </div>
    </footer>
  </div>
</dialog>

<style>
  .feature-tour {
    width: min(940px, calc(100vw - 32px));
    max-width: none;
    max-height: min(760px, calc(100dvh - 32px));
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid #b9b9b4;
    border-radius: 14px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 28px 90px rgba(20, 28, 48, .24), 0 4px 18px rgba(20, 28, 48, .1);
  }

  .feature-tour[open] { animation: feature-tour-in .28s cubic-bezier(.22, 1, .36, 1) both; }
  .feature-tour::backdrop { background: rgba(19, 22, 28, .62); backdrop-filter: blur(5px); }
  .feature-tour-shell { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; max-height: inherit; }

  .feature-tour-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 64px;
    padding: 13px 16px 13px 24px;
    border-bottom: 1px solid var(--line);
  }

  .feature-tour-header > div { display: flex; align-items: center; gap: 12px; }
  .feature-tour-header span { font: 700 .6875rem/1 var(--font-mono); letter-spacing: .09em; text-transform: uppercase; }
  .feature-tour-header strong { padding-left: 12px; border-left: 1px solid var(--line-dark); color: var(--muted); font: 500 .75rem/1 var(--font-mono); }
  .feature-tour-skip {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--muted);
    font-size: .75rem;
    font-weight: 650;
    cursor: pointer;
  }
  .feature-tour-skip:hover { background: #f0f0ed; color: var(--ink); }
  .feature-tour-skip:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }

  .feature-tour-stage { min-height: 0; overflow: auto; }
  .feature-tour-step { min-height: 440px; grid-template-columns: minmax(0, 1.25fr) minmax(270px, .75fr); }
  .feature-tour-step:not([hidden]) { display: grid; }

  .feature-tour-media {
    position: relative;
    min-height: 440px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #111317;
  }

  .feature-tour-media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset -1px 0 rgba(255, 255, 255, .08);
  }

  .feature-tour-media video { width: 100%; height: 100%; max-height: 520px; display: block; object-fit: contain; }
  .feature-tour-video-label {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 10px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 7px;
    background: rgba(17, 19, 23, .78);
    color: #fff;
    font-size: .75rem;
    font-weight: 650;
    backdrop-filter: blur(8px);
  }

  .feature-tour-copy { position: relative; display: flex; flex-direction: column; justify-content: center; padding: clamp(32px, 5vw, 58px); overflow: hidden; }
  .feature-tour-number { position: absolute; top: 18px; right: 24px; color: #ecece8; font: 750 5rem/1 var(--font-mono); letter-spacing: -.08em; user-select: none; }
  .feature-tour-copy h2 { position: relative; margin: 0; font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.02; letter-spacing: -.045em; }
  .feature-tour-copy h2:focus { outline: 0; }
  .feature-tour-copy p { position: relative; margin: 22px 0 0; color: var(--muted); font-size: .975rem; line-height: 1.7; }
  .feature-tour-footer {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 13px 16px 13px 24px;
    border-top: 1px solid var(--line);
    background: #fafaf8;
  }

  .feature-tour-progress { display: flex; align-items: center; gap: 8px; }
  .feature-tour-progress > span { width: 28px; height: 4px; overflow: hidden; border-radius: 999px; background: #d7d7d2; transition: background-color .2s ease; }
  .feature-tour-progress > span[aria-current="step"] { width: 52px; background: var(--blue); }
  .feature-tour-controls { display: flex; align-items: center; gap: 8px; }
  .feature-tour-controls > button { min-height: 42px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 16px; border-radius: 8px; font-size: .8125rem; font-weight: 700; cursor: pointer; transition: background-color .16s ease, border-color .16s ease, transform .16s ease, opacity .16s ease; }
  .feature-tour-controls > button:active:not(:disabled) { transform: translateY(1px); }
  .feature-tour-next { min-width: 110px; border: 1px solid var(--blue-deep); background: var(--blue); color: #fff; }
  .feature-tour-next:hover { background: var(--blue-deep); }
  .feature-tour-next:not([data-video-finished]) { border-color: var(--line-dark); background: #fff; color: var(--ink); }
  .feature-tour-next:not([data-video-finished]):hover { background: #f0f0ed; }
  .feature-tour-next .tour-done-icon { display: none; }
  .feature-tour-next[data-complete] .tour-next-icon { display: none; }
  .feature-tour-next[data-complete] .tour-done-icon { display: block; }

  @keyframes feature-tour-in {
    from { opacity: 0; transform: translateY(14px) scale(.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (max-width: 720px) {
    .feature-tour { width: calc(100vw - 20px); max-height: calc(100dvh - 20px); border-radius: 12px; }
    .feature-tour-header { min-height: 56px; padding: 10px 10px 10px 16px; }
    .feature-tour-header > div { gap: 8px; }
    .feature-tour-header strong { padding-left: 8px; }
    .feature-tour-step { min-height: 0; grid-template-columns: 1fr; }
    .feature-tour-media { min-height: 0; aspect-ratio: 16 / 10; }
    .feature-tour-media video { max-height: none; }
    .feature-tour-video-label { top: 10px; left: 10px; max-width: calc(100% - 20px); }
    .feature-tour-copy { justify-content: flex-start; padding: 28px 22px 30px; }
    .feature-tour-number { top: 16px; right: 20px; font-size: 3.75rem; }
    .feature-tour-copy h2 { max-width: calc(100% - 48px); font-size: clamp(1.8rem, 9vw, 2.4rem); }
    .feature-tour-copy p { margin-top: 16px; line-height: 1.6; }
    .feature-tour-footer { min-height: 66px; padding: 11px 12px 11px 16px; }
    .feature-tour-controls > button { min-height: 40px; padding-inline: 12px; }
    .feature-tour-next { min-width: 94px; }
  }

  @media (max-width: 420px) {
    .feature-tour-progress > span { width: 20px; }
    .feature-tour-progress > span[aria-current="step"] { width: 34px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-tour[open] { animation: none; }
    .feature-tour *, .feature-tour *::before, .feature-tour *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; }
  }
</style>

<script>
  const dialog = document.querySelector('[data-feature-tour]');

  if (dialog instanceof HTMLDialogElement) {
    const version = dialog.dataset.tourVersion ?? 'current';
    const storageKey = `bestjev:feature-tour:${version}`;
    const steps = [...dialog.querySelectorAll('[data-tour-step]')];
    const dots = [...dialog.querySelectorAll('[data-tour-dot]')];
    const counter = dialog.querySelector('[data-tour-counter]');
    const next = dialog.querySelector('[data-tour-next]');
    const skip = dialog.querySelector('[data-tour-skip]');
    const openers = [...document.querySelectorAll('[data-open-feature-tour]')];
    const nextLabel = next?.querySelector('span');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = 0;
    let autoOpenTimer: number | undefined;

    const rememberTour = () => {
      try { window.localStorage.setItem(storageKey, 'seen'); } catch { /* Storage can be disabled. */ }
    };

    const getActiveVideo = () => steps[activeIndex]?.querySelector('video');

    const syncNextButton = () => {
      if (!(next instanceof HTMLButtonElement) || !nextLabel) return;
      const finalStep = activeIndex === steps.length - 1;
      const video = getActiveVideo();
      const videoFinished = reducedMotion.matches
        || !(video instanceof HTMLVideoElement)
        || video.ended
        || video.dataset.tourUnavailable === 'true';

      next.toggleAttribute('data-final-step', finalStep);
      next.toggleAttribute('data-video-finished', videoFinished);
      nextLabel.textContent = videoFinished
        ? finalStep ? next.dataset.doneLabel ?? '' : next.dataset.nextLabel ?? ''
        : finalStep ? next.dataset.skipDoneLabel ?? '' : next.dataset.skipVideoLabel ?? '';
    };

    const playActiveVideo = () => {
      const video = getActiveVideo();
      if (!(video instanceof HTMLVideoElement) || reducedMotion.matches || !dialog.open) return;
      video.muted = true;
      void video.play().catch(() => {
        // Native controls remain available when a browser declines autoplay.
      });
    };

    const closeTour = () => {
      if (dialog.open) dialog.close();
    };

    const openTour = () => {
      if (dialog.open) return;
      steps.forEach((step) => {
        const video = step.querySelector('video');
        if (!(video instanceof HTMLVideoElement)) return;
        video.pause();
        video.currentTime = 0;
      });
      renderStep(0);
      dialog.showModal();
      playActiveVideo();
    };

    const renderStep = (index: number, focusHeading = false) => {
      activeIndex = Math.max(0, Math.min(index, steps.length - 1));
      dialog.setAttribute('aria-labelledby', `feature-tour-title-${activeIndex}`);
      dialog.setAttribute('aria-describedby', `feature-tour-description-${activeIndex}`);
      steps.forEach((step, stepIndex) => {
        const active = stepIndex === activeIndex;
        step.toggleAttribute('hidden', !active);
        step.setAttribute('aria-hidden', String(!active));
        const video = step.querySelector('video');
        if (!active && video instanceof HTMLVideoElement) video.pause();
      });
      dots.forEach((dot, dotIndex) => dot.toggleAttribute('aria-current', dotIndex === activeIndex));
      if (counter) counter.textContent = steps[activeIndex]?.getAttribute('data-counter-label') ?? `${activeIndex + 1} / ${steps.length}`;
      if (next instanceof HTMLButtonElement) next.toggleAttribute('data-complete', activeIndex === steps.length - 1);
      syncNextButton();
      playActiveVideo();
      if (focusHeading) steps[activeIndex]?.querySelector('h2')?.focus();
    };

    dialog.addEventListener('close', () => {
      steps.forEach((step) => {
        const video = step.querySelector('video');
        if (video instanceof HTMLVideoElement) video.pause();
      });
      rememberTour();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeTour();
    });
    skip?.addEventListener('click', closeTour);
    openers.forEach((opener) => opener.addEventListener('click', (event) => {
      event.preventDefault();
      if (autoOpenTimer !== undefined) window.clearTimeout(autoOpenTimer);
      openTour();
    }));
    next?.addEventListener('click', () => {
      if (activeIndex === steps.length - 1) {
        closeTour();
      }
      else renderStep(activeIndex + 1, true);
    });
    steps.forEach((step) => {
      const video = step.querySelector('video');
      if (!(video instanceof HTMLVideoElement)) return;
      video.addEventListener('ended', syncNextButton);
      video.addEventListener('play', syncNextButton);
      video.addEventListener('loadeddata', () => {
        delete video.dataset.tourUnavailable;
        syncNextButton();
      });
      video.addEventListener('error', () => {
        video.dataset.tourUnavailable = 'true';
        syncNextButton();
      });
    });
    reducedMotion.addEventListener('change', () => {
      syncNextButton();
      if (reducedMotion.matches) {
        const video = getActiveVideo();
        if (video instanceof HTMLVideoElement) video.pause();
      }
      else playActiveVideo();
    });

    let hasSeenTour = false;
    try { hasSeenTour = window.localStorage.getItem(storageKey) === 'seen'; } catch { /* Storage can be disabled. */ }
    const forceOpen = new URLSearchParams(window.location.search).get('tour') === '1';
    if (!hasSeenTour || forceOpen) {
      autoOpenTimer = window.setTimeout(openTour, 350);
    }
  }
</script>
