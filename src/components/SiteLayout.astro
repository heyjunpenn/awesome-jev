---
import { navigationCatalogStats, navigationCategories as catalogNavigationCategories } from '../data/catalog-navigation';
import type { Sponsor } from '../data/sponsors';
import { getMessages, localeConfig, locales, type Locale } from '../i18n';
import { getChangelogMessages } from '../i18n/changelog';
import { getLocalePath } from '../i18n/config';
import NewFeatureTour from './NewFeatureTour.astro';
import SponsorPanel from './SponsorPanel.astro';
import SiteFooter from './SiteFooter.astro';
import {
  AppWindow,
  BadgeCheck,
  Blocks,
  BrainCircuit,
  Bot,
  ChartNoAxesCombined,
  Check,
  ChevronDown,
  FlaskConical,
  Gamepad2,
  ListRestart,
  LayoutGrid,
  ListTree,
  Menu,
  MonitorSmartphone,
  Workflow,
  X,
} from '@lucide/astro';

type ActiveSection = 'catalog' | 'changelog' | 'sponsors';

interface Props {
  locale: Locale;
  activeSection?: ActiveSection;
  activeFilter?: string;
  mainClass?: string;
  sponsors?: Sponsor[];
}

const {
  locale,
  activeSection = 'catalog',
  activeFilter = 'all',
  mainClass,
  sponsors = [],
} = Astro.props;
const base = import.meta.env.BASE_URL;
const messages = getMessages(locale);
const changelogCopy = getChangelogMessages(locale);
const categories = catalogNavigationCategories[locale];
const repositoryUrl = process.env.GITHUB_REPOSITORY
  ? `https://github.com/${process.env.GITHUB_REPOSITORY}`
  : 'https://github.com/heyjunpenn/awesome-jev';
const filterHref = (filter: string, targetLocale: Locale = locale) =>
  `${base}${getLocalePath(targetLocale)}${filter === 'all' ? '' : `projects/${filter}/`}`;
const changelogHref = (targetLocale: Locale = locale) => `${base}${getLocalePath(targetLocale)}changelog/`;
const sponsorsHref = (targetLocale: Locale = locale) => `${base}${getLocalePath(targetLocale)}sponsors/`;
const categoryIcons = [BadgeCheck, Blocks, BrainCircuit, Workflow, Bot, MonitorSmartphone, AppWindow, Gamepad2, FlaskConical, ChartNoAxesCombined, ListTree];
const jevLikeCategoryId = 'jev-like-models';
const navigationCategories = categories
  .map((category, index) => ({ ...category, Icon: categoryIcons[index] ?? LayoutGrid }))
  .filter((category) => category.id !== jevLikeCategoryId);
const catalogActive = activeSection === 'catalog';
const sidebarCategories = navigationCategories;
const sidebarCategoryLabel = messages.nav.categories;
const sidebarCategoryHref = filterHref;
const brandHref = catalogActive ? '#overview' : filterHref('all');
const localeHref = (candidate: Locale) => {
  if (catalogActive) return filterHref(activeFilter, candidate);
  if (activeSection === 'sponsors') return sponsorsHref(candidate);
  if (activeSection === 'changelog') return changelogHref(candidate);
  return filterHref('all', candidate);
};
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-scroll">
    <div class="sidebar-head">
      <a class="brand" href={brandHref} title={messages.nav.home} aria-label={messages.nav.home}>
        <img class="brand-logo" src={`${base}brand/bestjev-logo-rounded.svg`} alt={messages.nav.logoAlt} width="136" height="34" />
        <span class="sr-only">{messages.nav.home}</span>
      </a>
      <button class="sidebar-close" type="button" aria-label={messages.nav.close}><X size={18} stroke-width={1.8} /></button>
    </div>

    <div class="sidebar-primary">
      <nav class="side-nav primary-nav" aria-label={messages.nav.primary}>
        <a class:list={[catalogActive && activeFilter === 'all' && 'selected']} href={filterHref('all')} title={messages.nav.allProjects} aria-current={catalogActive && activeFilter === 'all' ? 'page' : undefined}><LayoutGrid class="nav-icon" size={17} stroke-width={1.8} /><span>{messages.nav.allProjects}</span><small>{navigationCatalogStats.projects}</small></a>
        <a class:list={[activeSection === 'changelog' && 'selected']} href={changelogHref()} title={changelogCopy.navLabel} aria-current={activeSection === 'changelog' ? 'page' : undefined}><ListRestart class="nav-icon" size={17} stroke-width={1.8} /><span>{changelogCopy.navLabel}</span><small>{navigationCatalogStats.changelogDays}</small></a>
        <a href={repositoryUrl} title={messages.nav.githubRepository} target="_blank" rel="noreferrer" aria-label={messages.nav.githubRepository}>
          <svg class="nav-icon github-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
          </svg>
          <span>GitHub</span>
        </a>
      </nav>
    </div>

    <div class="sidebar-categories">
      <div class="category-nav-head"><span>{sidebarCategoryLabel}</span></div>
      <nav class="category-nav" aria-label={messages.nav.projectCategories}>
        {sidebarCategories.map(({ Icon, ...category }) => (
          <a
            class:list={[catalogActive && activeFilter === category.id && 'selected']}
            aria-current={catalogActive && activeFilter === category.id ? 'page' : undefined}
            href={sidebarCategoryHref(category.id)}
            title={category.name}
          >
            <Icon class="nav-icon" size={16} stroke-width={1.75} />
            <span>{category.name}</span>
            <small>{category.count}</small>
          </a>
        ))}
      </nav>
    </div>
  </div>

  <div class="sidebar-foot">
    <SponsorPanel locale={locale} sponsors={sponsors} />
    <div class="locale-picker" data-locale-picker>
      <button class="locale-trigger" type="button" aria-label={messages.nav.language} aria-haspopup="listbox" aria-expanded="false" aria-controls="locale-options">
        <img src={`${base}flags/${localeConfig[locale].flag}.svg`} alt={messages.nav.flagAlt(localeConfig[locale].label)} aria-hidden="true" width="28" height="20" />
        <span>{localeConfig[locale].label}</span>
        <ChevronDown size={15} stroke-width={1.8} aria-hidden="true" />
      </button>
      <div class="locale-menu" id="locale-options" role="listbox" aria-label={messages.nav.language} hidden>
        {locales.map((candidate) => (
          <a
            class:list={['locale-option', candidate === locale && 'selected']}
            href={localeHref(candidate)}
            title={localeConfig[candidate].label}
            lang={localeConfig[candidate].languageTag}
            hreflang={localeConfig[candidate].languageTag}
            role="option"
            aria-selected={candidate === locale ? 'true' : 'false'}
            aria-current={candidate === locale ? 'page' : undefined}
          >
            <img src={`${base}flags/${localeConfig[candidate].flag}.svg`} alt={messages.nav.flagAlt(localeConfig[candidate].label)} aria-hidden="true" width="28" height="20" />
            <span>{localeConfig[candidate].label}</span>
            <Check size={14} stroke-width={2} aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>
  </div>
</aside>

<main class={mainClass}>
  <header class="mobile-header">
    <a class="brand" href={brandHref} title={messages.nav.home} aria-label={messages.nav.home}><img class="brand-logo" src={`${base}brand/bestjev-logo-rounded.svg`} alt={messages.nav.logoAlt} width="136" height="34" /><span class="sr-only">{messages.nav.home}</span></a>
    <button class="menu-button" type="button" aria-label={messages.nav.open} aria-controls="sidebar" aria-expanded="false"><Menu size={19} stroke-width={1.8} /></button>
  </header>
  <button class="nav-scrim" type="button" aria-label={messages.nav.close} tabindex="-1"></button>
  <slot />
  <SiteFooter locale={locale} />
</main>

<NewFeatureTour locale={locale} />
